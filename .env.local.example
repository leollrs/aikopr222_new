# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Chat API (server-only, never use VITE_ prefix)
OPENAI_API_KEY=your_openai_api_key
# Optional model override
OPENAI_MODEL=gpt-4o-mini
# Optional API server port
API_PORT=8787
# Chat webhook for widget responses
CHAT_WEBHOOK_URL=https://leollrs.app.n8n.cloud/webhook/aikopr222/chat
# Optional direct client fallback (used if /api/chat is unavailable)
VITE_CHAT_WEBHOOK_URL=https://leollrs.app.n8n.cloud/webhook/aikopr222/chat
# Optional intake webhook override
INTAKE_WEBHOOK_URL=https://leollrs.app.n8n.cloud/webhook/intake
