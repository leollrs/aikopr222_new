# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Chat API (server-only, never use VITE_ prefix)
OPENAI_API_KEY=your_openai_api_key
# Optional model override
OPENAI_MODEL=gpt-4o-mini
# Optional API server port
API_PORT=8787
# Chat webhook for widget responses
CHAT_WEBHOOK_URL=https://leollrs.app.n8n.cloud/webhook/aikopr222/chat
# Optional direct client fallback (used if /api/chat is unavailable)
VITE_CHAT_WEBHOOK_URL=https://leollrs.app.n8n.cloud/webhook/aikopr222/chat
# Optional intake webhook override
INTAKE_WEBHOOK_URL=https://leollrs.app.n8n.cloud/webhook/intake

# Supabase server-side auth validation for admin-only API routes
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth (admin sync flow)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/google-calendar/oauth/callback
GOOGLE_OAUTH_APP_URL=http://localhost:5173

# Google Calendar availability (optional but recommended for booking slots)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Example: -04:00 for Puerto Rico / AST
GOOGLE_CALENDAR_UTC_OFFSET=-04:00
GOOGLE_CALENDAR_TIMEZONE=America/Puerto_Rico
